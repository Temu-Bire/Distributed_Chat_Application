# ===================================================================
# Local PostgreSQL configuration (Default for Docker Compose)
# ===================================================================
POSTGRES_DB=chat_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Spring Boot Datasource (Local)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/chat_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# ===================================================================
# Neon Cloud PostgreSQL configuration (Alternative Cloud Setup)
# ===================================================================
# SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-hostname>/<database>?sslmode=require
# SPRING_DATASOURCE_USERNAME=<neon-username>
# SPRING_DATASOURCE_PASSWORD=<neon-password>
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# ===================================================================
# Flyway Migration (Enable to auto-run Flyway scripts on startup)
# ===================================================================
SPRING_FLYWAY_ENABLED=true

# ===================================================================
# Redis configuration
# ===================================================================
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379

# ===================================================================
# Distributed mode toggle (true = Redis presence & pub/sub relay; false = in-memory store)
# ===================================================================
CHAT_DISTRIBUTED_ENABLED=true

# Server Port
PORT=8080
